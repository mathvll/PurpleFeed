{
  "name": "purplefeed",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development tsx --tsconfig config/tsconfig.json server/index.ts",
    "build": "vite build --config config/vite.config.ts && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --alias:@shared=./shared --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc -p config/tsconfig.json",
    "db:push": "drizzle-kit push --config=config/drizzle.config.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@neondatabase/serverless": "^0.10.4",
    "@radix-ui/react-label": "^2.1.3",
